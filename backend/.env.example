# ===== DeepSeek =====
# 必填：在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=

# 可选：自定义 DeepSeek 接口地址（默认官方平台）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== B 站视频解析 =====
# 可选：浏览器登录 bilibili.com → F12 → Application → Cookies 复制 SESSDATA。
# 不配置也能运行链路，但 B 站对未登录请求可能触发风控。
BILI_SESSDATA=

# ===== 数据库 =====
# 默认 SQLite，可切换为 PostgreSQL
DATABASE_URL=sqlite:///./knowledgeos.db

# ===== 安全加固（可选，配置后生效）=====
# API 访问令牌：设置一个随机长字符串后，所有 /api 请求必须携带请求头
# X-API-Key 且值一致，否则返回 401。用于防公网被任意调用消耗 DeepSeek 额度。
# 需同步在 frontend/.env 中把 VITE_API_KEY 设为同一个值。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_API_KEY=

# CORS 允许的前端来源（JSON 数组）。默认只放行本地开发地址；
# 前端部署到其它域名时，把该域名加进来，例如：
# CORS_ORIGINS=["https://your-demo.example.com"]
